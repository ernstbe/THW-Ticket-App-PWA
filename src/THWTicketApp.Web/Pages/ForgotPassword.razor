@page "/passwort-vergessen"
@layout THWTicketApp.Web.Layout.LoginLayout
@using MudBlazor
@inject THWTicketApp.Shared.Services.ITrueDeskApiService ApiService
@inject THWTicketApp.Web.Services.AppSettingsInitializer SettingsInit
@inject THWTicketApp.Web.Services.LocalizationService L

@* #invite: request a 1-hour reset link by mail. The server answers the
   same for unknown addresses, so the page always shows the same message. *@
<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-8 mx-auto" Style="width: 100%; max-width: 440px;">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex flex-column align-center">
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2">THW</MudText>
                    <MudText Typo="Typo.h5">@L.T("forgot.title")</MudText>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_sent)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@L.T("forgot.sent")</MudAlert>
            }
            else
            {
                <MudText Class="mb-4">@L.T("forgot.intro")</MudText>
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
                }
                <MudTextField @bind-Value="_email" Label="@L.T("forgot.email")" Variant="Variant.Outlined"
                              InputType="InputType.Email" Disabled="@_isLoading" Class="mb-3"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           OnClick="@SubmitAsync" Disabled="@_isLoading">
                    @L.T("forgot.submit")
                </MudButton>
            }
            <MudLink Href="login" Typo="Typo.body2" Color="Color.Primary" Class="mt-4 d-block text-center">
                @L.T("link.to_login")
            </MudLink>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string _email = string.Empty;
    private string? _errorMessage;
    private bool _isLoading;
    private bool _sent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await SettingsInit.InitializeAsync();
    }

    private async Task SubmitAsync()
    {
        if (_isLoading) return;
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _errorMessage = L.T("forgot.email_invalid");
            return;
        }
        _isLoading = true;
        StateHasChanged();
        try
        {
            if (await ApiService.RequestPasswordResetAsync(_email.Trim())) _sent = true;
            else _errorMessage = L.T("forgot.failed");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
