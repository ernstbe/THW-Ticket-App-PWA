@page "/login"
@layout THWTicketApp.Web.Layout.LoginLayout
@using MudBlazor
@using Microsoft.JSInterop
@inject THWTicketApp.Shared.Services.ITrueDeskApiService ApiService
@inject THWTicketApp.Shared.Services.AppSettings AppSettings
@inject THWTicketApp.Web.Services.AuthStateProvider AuthStateProvider
@inject THWTicketApp.Web.Services.AppSettingsInitializer SettingsInit
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject THWTicketApp.Web.Services.LocalizationService L
@inject THWTicketApp.Web.Services.LocalStorageService LocalStorage
@implements IAsyncDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-8 mx-auto" Style="width: 100%; max-width: 420px;">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex flex-column align-center">
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2">THW</MudText>
                    <MudText Typo="Typo.h5">Ticket App</MudText>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @* Passkey Login Button *@
            @if (_passkeyAvailable)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           OnClick="@LoginWithPasskeyAsync" Disabled="@_isLoading" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Fingerprint" Class="mb-4">
                    @L.T("login.passkey")
                </MudButton>
                <div class="d-flex align-center gap-2 mb-4">
                    <MudDivider />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L.T("common.or")</MudText>
                    <MudDivider />
                </div>
            }

            @* Server-config panel only on first run. Once configured, the URL lives in
               local storage and the panel becomes pointless visual noise. To change the
               URL later, clear site data or use the dev console. *@
            @if (!_serverConfigured)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    @L.T("login.configure_server")
                </MudAlert>

                <MudExpansionPanels Class="mb-4" Elevation="0">
                    <MudExpansionPanel Text="@L.T("login.server_config")" Expanded="true"
                                       Style="background: transparent;">
                        <MudTextField @bind-Value="_serverUrl" Label="@L.T("login.server_url")"
                                      Placeholder="https://trudesk.example.com/api/v2"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Dns"
                                      Disabled="@_isLoading" Class="mb-2" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   OnClick="SaveServerUrlAsync" FullWidth="true">
                            @L.T("login.save_url")
                        </MudButton>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            <MudForm @ref="_form">
                <MudTextField @bind-Value="_username" Label="@L.T("login.username")" Variant="Variant.Outlined"
                              Required="true" RequiredError="@L.T("login.username_required")"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                              Disabled="@(_isLoading || !_serverConfigured)" Class="mb-4"
                              OnKeyDown="@OnKeyDown" />
                <MudTextField @bind-Value="_password" Label="@L.T("login.password")" Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true" RequiredError="@L.T("login.password_required")"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                              Disabled="@(_isLoading || !_serverConfigured)"
                              OnKeyDown="@OnKeyDown" />
            </MudForm>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
            }
        </MudCardContent>
        <MudCardActions Class="d-flex flex-column px-6 pb-6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="@LoginAsync" Disabled="@(_isLoading || !_serverConfigured)" Size="Size.Large">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">@L.T("login.submitting")</MudText>
                }
                else
                {
                    <MudText>@L.T("login.submit")</MudText>
                }
            </MudButton>
            <MudLink Href="register" Typo="Typo.body2" Color="Color.Primary" Class="mt-4 align-self-center">
                @L.T("login.register_link")
            </MudLink>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = null!;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _serverUrl = string.Empty;
    private string? _errorMessage;
    private bool _isLoading;
    private bool _passkeyAvailable;
    private bool _serverConfigured;
    private IJSObjectReference? _webauthnModule;
    private string? _lastPasskeyUsername;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SettingsInit.InitializeAsync();
            _serverUrl = AppSettings.ApiBaseUrl;
            _serverConfigured = AppSettings.IsConfigured;
            StateHasChanged();

            _lastPasskeyUsername = await LocalStorage.GetItemAsync("last_passkey_username");

            try
            {
                _webauthnModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/webauthn-interop.js");
                // Server-verified now (#205): the button offers passwordless
                // login to any WebAuthn-capable browser, not just a device
                // that previously registered a passkey here — a synced
                // passkey (iCloud/Google) on a second device works too.
                _passkeyAvailable = await _webauthnModule.InvokeAsync<bool>("isWebAuthnSupported");
                if (!string.IsNullOrEmpty(_lastPasskeyUsername))
                    _username = _lastPasskeyUsername;
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task SaveServerUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_serverUrl))
        {
            _errorMessage = L.T("login.invalid_url");
            return;
        }
        await SettingsInit.SaveApiUrlAsync(_serverUrl);
        _serverConfigured = AppSettings.IsConfigured;
        _errorMessage = null;
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoginAsync();
    }

    private async Task LoginAsync()
    {
        // Re-entrancy guard: the fields/button only become Disabled on the next
        // render, so Enter key auto-repeat (or Enter-then-click) can fire this
        // twice before _isLoading is set, launching two concurrent logins (#275).
        if (_isLoading) return;

        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var success = await ApiService.AuthenticateAsync(_username, _password);
            if (success)
            {
                AuthStateProvider.NotifyAuthStateChanged();
                Navigation.NavigateTo("./");
            }
            else
            {
                _errorMessage = L.T("login.failed");
            }
        }
        catch (Exception ex)
        {
            // Show a localized, generic message; the raw exception (which can
            // include the configured internal API URL) goes to the console only (#276).
            Console.Error.WriteLine($"Login failed: {ex}");
            _errorMessage = L.T("login.connection_error");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoginWithPasskeyAsync()
    {
        if (_webauthnModule == null || _isLoading) return;

        // No remembered device username (fresh device / cleared storage) —
        // need one to ask the server which credentials to challenge.
        var username = string.IsNullOrEmpty(_lastPasskeyUsername) ? _username.Trim() : _lastPasskeyUsername;
        if (string.IsNullOrEmpty(username))
        {
            _errorMessage = L.T("login.passkey_username_required");
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var optionsJson = await ApiService.GetWebauthnAuthenticationOptionsAsync(username);
            if (optionsJson == null)
            {
                _errorMessage = L.T("login.connection_error");
                return;
            }

            var assertionJson = await _webauthnModule.InvokeAsync<string?>("getAssertion", optionsJson);
            if (string.IsNullOrEmpty(assertionJson))
            {
                // Biometric prompt was cancelled, or the browser has no
                // matching credential for this username's allowCredentials.
                _errorMessage = L.T("login.passkey_failed");
                return;
            }

            var success = await ApiService.VerifyWebauthnAuthenticationAsync(username, assertionJson);
            if (success)
            {
                AuthStateProvider.NotifyAuthStateChanged();
                Navigation.NavigateTo("./");
                return;
            }

            _errorMessage = L.T("login.passkey_failed");
        }
        catch
        {
            _errorMessage = L.T("login.passkey_cancelled");
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_webauthnModule != null)
            await _webauthnModule.DisposeAsync();
    }
}
